<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NFC Vault"
            android:textColor="#00E5FF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textColor="#9FB0D0"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tileScan"
                style="@style/Tile"
                android:layout_height="0dp"
                android:layout_weight="1.3"
                android:background="@drawable/tile_accent"
                android:text="📡\nمسح كارت جديد"
                android:textColor="#04121A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tileSaved"
                    style="@style/Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🗂️\nالكروت المحفوظة" />

                <TextView
                    android:id="@+id/tileExport"
                    style="@style/Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="📤\nتصدير" />
            </LinearLayout>

            <TextView
                android:id="@+id/tileClear"
                style="@style/Tile"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:text="🗑️  حذف الكل"
                android:textColor="#FF6B6B" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/back"
                style="@style/Tile"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="⬅️  رجوع" />

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#22FFFFFF"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
